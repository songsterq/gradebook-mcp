{
  "name": "gradebook-mcp",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "description": "ParentVUE gradebook MCP server and dashboard: a local, read-only snapshot of your kids' grades and missing work",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/songsterq/gradebook-mcp.git"
  },
  "keywords": [
    "mcp",
    "parentvue",
    "studentvue",
    "gradebook",
    "synergy",
    "edupoint",
    "homelab"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "jose": "^6.2.11",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}

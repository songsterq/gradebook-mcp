# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Image tag Compose runs. Blank means latest. Pin a minor line such as 0.2 to
# take only fixes, or an exact release such as 0.2.0 to change nothing until
# you edit this.
GRADEBOOK_VERSION=
# Both listeners are optional and each is disabled by a blank port, but at
# least one must be set or the server refuses to start.
# PORT: the authenticated MCP endpoint. Blank runs the dashboard only, and then
# no MCP auth is required below.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
# IANA timezone used for "today" when deciding which reporting period is current.
TZ=UTC
# Host address Compose publishes the MCP port on. Keep it on loopback and put a
# reverse proxy, tunnel, or overlay network in front (see README).
MCP_BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
# Dashboard (optional, UNAUTHENTICATED). Blank disables the listener.
# It has its own port so the route that exposes /mcp can never serve the UI.
# Publish only to a private network; never to the Internet.
# For a dashboard-only install, set UI_PORT here and leave PORT blank above.
# ---------------------------------------------------------------------------
UI_PORT=
# Interface for the dashboard listener inside the container. Defaults to HOST.
UI_HOST=
# Host address Compose publishes the dashboard port on. Keep this on loopback,
# or set it to a private/overlay-network address for a direct bind.
UI_BIND_ADDR=127.0.0.1

# Dashboard-only installs refuse to start in production when UI_HOST is a
# wildcard (0.0.0.0 / ::), because nothing else would confine the
# unauthenticated dashboard. Set this to true only when something outside the
# process does confine it. The Docker image sets it already: a container must
# bind 0.0.0.0 for Docker to publish the port, and Compose publishes only to
# UI_BIND_ADDR on the host. Leave it blank when running directly on a host.
UI_ALLOW_WILDCARD_BIND=

# Data directory (Compose overrides this to /data on a named volume)
DATA_DIR=./data

# ---------------------------------------------------------------------------
# MCP authentication. Required only when the MCP endpoint is enabled (PORT is
# set); a dashboard-only install ignores this whole section.
# When MCP is enabled, configure EXACTLY ONE of the two modes below.
# ---------------------------------------------------------------------------
# Mode A: static bearer token. Clients send `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Mode B: Cloudflare Access. The origin verifies the Cf-Access-Jwt-Assertion
# JWT that Access injects, then checks the identity against the allowlists.
# Team domain with scheme and no trailing slash, e.g. https://<team>.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag of the self-hosted Access application
ACCESS_AUD=
# Comma-separated user emails allowed through (OAuth / IdP logins)
ALLOWED_EMAILS=
# Comma-separated service token Client IDs (the JWT common_name), not display names
ALLOWED_SERVICE_TOKENS=

# ---------------------------------------------------------------------------
# ParentVUE. Without all three the server still starts: the dashboard shows an
# empty state and syncs report `not_configured`.
# ---------------------------------------------------------------------------
# Your district's ParentVUE host, no scheme, e.g. <district>.edupoint.com
GRADEBOOK_PARENTVUE_HOST=
GRADEBOOK_PARENTVUE_USER=
GRADEBOOK_PARENTVUE_PASS=
# Master on/off switch for automatic syncs. Default false: some districts'
# ParentVUE terms prohibit software that logs in automatically, so leave it
# off unless you have read and accepted your district's terms.
GRADEBOOK_SYNC_ENABLED=false
# Hours between automatic syncs; 0 also disables the in-process scheduler.
GRADEBOOK_SYNC_INTERVAL_HOURS=24
# Optional comma-separated student name allowlist; empty syncs all children.
GRADEBOOK_STUDENTS=

# ---------------------------------------------------------------------------
# Local development ONLY. Never set this in Compose / production.
# Only honored when NODE_ENV != production AND HOST is 127.0.0.1 or ::1.
# ---------------------------------------------------------------------------
DEV_INSECURE_NO_AUTH=false
